cbuffer SharedConstants : register(b2, space4)
{
	uint tex0_Texture2DDescriptorIndex : packoffset(c0.x);
	uint tex0_Texture3DDescriptorIndex : packoffset(c4.x);
	uint tex0_TextureCubeDescriptorIndex : packoffset(c8.x);
	uint tex0_SamplerDescriptorIndex : packoffset(c12.x);
	DEFINE_SHARED_CONSTANTS();
};

